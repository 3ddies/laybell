{
  "expo": {
    "name": "Laybell",
    "slug": "laybell",
    "scheme": "laybell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FF0A00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laybell.app",
      "associatedDomains": [
        "applinks:laybell.app",
        "webcredentials:laybell.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationDefaultAccuracyReduced": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.laybell.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FF0A00",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash-icon-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#FF0A00"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/reel"
            },
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/playlist"
            },
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/communities"
            },
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/story"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Laybell to access your photos so you can choose one to post.",
          "savePhotosPermission": "Allow Laybell to save captured stories to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Laybell to access your photos so you can choose one to post."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Laybell to use your camera to capture photos and videos for posts and stories, and to broadcast livestreams.",
          "microphonePermission": "Allow Laybell to use your microphone to record audio for posts, videos and stories, and for livestreams and studio sessions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F26522",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Laybell to use your approximate location to suggest people near you.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Laybell to access your contacts to find people you may know on Laybell."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Laybell to use your microphone to record audio for posts, videos and stories, and for livestreams and studio sessions."
        }
      ],
      "expo-video",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Laybell to use your camera to capture photos and videos for posts and stories, and to broadcast livestreams.",
          "microphonePermission": "Allow Laybell to use your microphone to record audio for posts, videos and stories, and for livestreams and studio sessions."
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "iosDisableDiscoveryAutostart": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.102825886853-qmqp3uea0vqgljigkhtdhnbq0tjqkur7"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "laybell-llc",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83e40be5-3467-49af-898b-1a4c07d3bed4"
      },
      "revenuecat": {
        "iosApiKey": "appl_bmySsLnbZuPipewzsNbsuzMoYYL",
        "androidApiKey": "",
        "entitlement": "premium"
      }
    }
  }
}
