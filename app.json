{
  "expo": {
    "name": "Laybell",
    "slug": "laybell",
    "scheme": "laybell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laybell.app",
      "associatedDomains": [
        "applinks:laybell.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.laybell.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "laybell.app",
              "pathPrefix": "/post"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Laybell to access your photos so you can choose one to post.",
          "savePhotosPermission": "Allow Laybell to save captured stories to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Laybell to use your camera to capture stories and posts.",
          "microphonePermission": "Allow Laybell to use your microphone for video stories.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F26522",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Laybell to use your approximate location to suggest people near you."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Laybell to access your contacts to find people you may know on Laybell."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Laybell to record audio for your posts."
        }
      ],
      "expo-video",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Laybell to use your camera to broadcast livestreams.",
          "microphonePermission": "Allow Laybell to use your microphone for livestreams and studio sessions."
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "iosDisableDiscoveryAutostart": true
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83e40be5-3467-49af-898b-1a4c07d3bed4"
      },
      "revenuecat": {
        "iosApiKey": "",
        "androidApiKey": "",
        "entitlement": "premium"
      }
    }
  }
}
